{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuickAction data and backup",
  "type": "object",
  "required": ["format", "schemaVersion", "configuration", "assets"],
  "properties": {
    "format": { "const": "quickaction" },
    "schemaVersion": { "const": 1 },
    "configuration": {
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "language": { "enum": ["vi", "en"] },
        "monitor": { "type": "string" },
        "edge": { "enum": ["Left", "Right", "Top", "Bottom"] },
        "iconSize": { "enum": ["Small", "Medium", "Big"], "default": "Small" },
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "opacity": { "type": "number", "minimum": 0.3, "maximum": 1 },
        "collapseMilliseconds": { "type": "integer", "minimum": 200, "maximum": 5000 },
        "topmost": { "type": "boolean" },
        "startup": { "type": "boolean" },
        "shortcuts": {
          "type": "array", "maxItems": 10000,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "arguments": { "type": "string" },
              "workingDirectory": { "type": "string" },
              "icon": { "type": "string" },
              "admin": { "type": "boolean" },
              "pinOrder": { "type": ["integer", "null"] },
              "steps": {
                "description": "Null for a single app. Group dependencies reference earlier step IDs; nested groups are not supported.",
                "type": ["array", "null"], "minItems": 1, "maxItems": 1000,
                "items": {
                  "type": "object",
                  "required": ["id", "app"],
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "app": {
                      "allOf": [
                        { "$ref": "#/properties/configuration/properties/shortcuts/items" },
                        { "properties": { "steps": { "type": "null" } } }
                      ]
                    },
                    "dependsOn": { "type": ["string", "null"], "format": "uuid" },
                    "condition": { "enum": [null, "Together", "InputIdle", "Finished"] },
                    "delaySeconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "assets": {
      "description": "Backup: icon filename to base64 bytes. Local config: empty; files live in icons/.",
      "type": "object",
      "additionalProperties": { "type": "string", "contentEncoding": "base64" }
    }
  }
}
