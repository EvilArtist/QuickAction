<Window x:Class="QuickAction.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.2}"
        Width="1040" Height="780" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource Window.Base}">

    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Colors.xaml"/><ResourceDictionary Source="Themes/Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
        <Grid Background="{DynamicResource Brush.Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--  SIDEBAR  -->
        <Border Background="{DynamicResource Brush.Sidebar}" Padding="16,24,16,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Accent}">
                            <TextBlock Text="&#xE945;" FontFamily="{DynamicResource Font.Icon}" FontSize="15"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="QuickAction" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Loc.3}"
                               Foreground="#8F97B5" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource Loc.4}" Foreground="#6C7494" FontSize="11"
                           Margin="12,0,0,0"/>

                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource ListBoxItem.Nav}"
                         SelectedIndex="{Binding SelectedIndex, ElementName=Pages, Mode=TwoWay}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{DynamicResource Font.Icon}" Width="22" FontSize="15"/>
                            <TextBlock Text="{DynamicResource Loc.5}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{DynamicResource Font.Icon}" Width="22" FontSize="15"/>
                            <TextBlock Text="{DynamicResource Loc.0}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource Font.Icon}" Width="22" FontSize="15"/>
                        <TextBlock Text="{DynamicResource Loc.6}" Margin="8,0,0,0"/>
                    </StackPanel></ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>
        <TabControl x:Name="Pages" Grid.Column="1" SelectedIndex="0" Style="{StaticResource TabControl.Pages}">
            <TabItem>
                <Grid Margin="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="268"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Border.Card}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Button x:Name="AddShortcutButton" Style="{StaticResource Button.Primary}" Height="38" Content="{DynamicResource Loc.7}"/>
                            <TextBox x:Name="SearchBox" Grid.Row="1" Tag="{DynamicResource Loc.8}" Height="34" Margin="0,10,0,10"/>
                            <Grid Grid.Row="2">
                                <ListBox x:Name="ShortcutList" IsSynchronizedWithCurrentItem="False" BorderThickness="0" Background="Transparent" AllowDrop="True"
                                         ItemContainerStyle="{StaticResource ListBoxItem.Shortcut}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                            <ContentControl Content="{Binding}" Loaded="ShortcutIconLoaded" Width="30" Height="30"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE840;" FontFamily="{DynamicResource Font.Icon}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding PinOrder}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Border x:Name="EmptyState" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" IsHitTestVisible="False">
                                    <StackPanel VerticalAlignment="Center" Margin="16">
                                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource Font.Icon}" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock x:Name="EmptyTitle" Text="{DynamicResource Loc.9}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBlock Text="{DynamicResource Loc.10}" Style="{StaticResource TextBlock.FieldHint}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Form chỉnh sửa -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Thông tin chương trình -->
                                <Border Style="{StaticResource Border.Card}" Padding="20" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.11}" Style="{StaticResource TextBlock.SectionTitle}"/>

                                        <TextBlock Text="{DynamicResource Loc.12}" Style="{StaticResource TextBlock.FieldLabel}"/>
                                        <TextBox x:Name="NameBox" Tag="{DynamicResource Loc.13}"/>

                                        <TextBlock Text="{DynamicResource Loc.14}" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,12,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PathBox" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                     Tag="{DynamicResource Loc.15}"/>
                                            <Button x:Name="BrowsePathButton" Grid.Column="1" Content="{DynamicResource Loc.16}"
                                                    Height="36" Margin="8,0,0,0"/>
                                        </Grid>

                                        <Button x:Name="ChooseInstalledAppButton" Content="{DynamicResource Loc.17}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0"/>

                                        <TextBlock Text="{DynamicResource Loc.18}" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,12,0,6"/>
                                        <TextBox x:Name="ArgsBox" Tag="{DynamicResource Loc.19}"/>
                                        <TextBlock Style="{StaticResource TextBlock.FieldHint}"
                                                   Text="{DynamicResource Loc.20}"/>

                                        <TextBlock Text="{DynamicResource Loc.21}" Style="{StaticResource TextBlock.FieldLabel}" Margin="0,12,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="WorkDirBox" ToolTip="{DynamicResource Loc.22}"
                                                     Tag="{DynamicResource Loc.22}"/>
                                            <Button x:Name="BrowseWorkDirButton" Grid.Column="1" Content="{DynamicResource Loc.23}"
                                                    Height="36" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Tuỳ chọn chạy -->
                                <Border Style="{StaticResource Border.Card}" Padding="20" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.24}" Style="{StaticResource TextBlock.SectionTitle}"/>

                                        <CheckBox x:Name="AdminCheck" HorizontalAlignment="Left">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Loc.25}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text}"/>
                                                <TextBlock Text="{DynamicResource Loc.26}"
                                                           FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            </StackPanel>
                                        </CheckBox>

                                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,12"/>

                                        <TextBlock Text="{DynamicResource Loc.27}" Style="{StaticResource TextBlock.FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="IconModeCombo" SelectedIndex="0">
                                                <ComboBoxItem Content="{DynamicResource Loc.28}"/>
<ComboBoxItem Content="{DynamicResource Loc.29}"/>
<ComboBoxItem Content="{DynamicResource Loc.30}"/>
<ComboBoxItem Content="{DynamicResource Loc.31}"/>
<ComboBoxItem Content="{DynamicResource Loc.32}"/>
<ComboBoxItem Content="{DynamicResource Loc.33}"/>
<ComboBoxItem Content="{DynamicResource Loc.34}"/>
                                            </ComboBox>
                                            <Button x:Name="BrowseIconButton" Grid.Column="1" Content="{DynamicResource Loc.35}"
                                                    Height="36" Margin="8,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="IconStatus" Style="{StaticResource TextBlock.FieldHint}" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="RunButton" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{DynamicResource Font.Icon}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Loc.36}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Thanh hành động luôn hiển thị -->
                        <Border Grid.Row="1" Style="{StaticResource Border.Card}" Padding="12" Margin="0,8,0,0">
                            <WrapPanel>
                                <Button x:Name="SaveButton" DockPanel.Dock="Left" Content="{DynamicResource Loc.37}"
                                        Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
                                <Button x:Name="PinButton" DockPanel.Dock="Left" Content="{DynamicResource Loc.38}"
                                       />

                                <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="{DynamicResource Loc.39}"
                                        Style="{StaticResource Button.Danger}" Margin="8,0,0,0"/>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!--  Tab 2: Dock & hệ thống  -->
            <TabItem>
                <Border Style="{StaticResource Border.Card}" Margin="24" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="PreferencesHost"/></ScrollViewer>
                </Border>
            </TabItem>

            <!--  Tab 3: Sao lưu  -->
            <TabItem>
                <Border Style="{StaticResource Border.Card}" Margin="24" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="BackupHost"/></ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

